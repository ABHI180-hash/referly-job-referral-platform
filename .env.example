# Referly — Job Referral & Career Networking Platform
# Environment Configuration Template
# Copy this file to .env before starting the server

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI)
# Note: If no external MongoDB URI is provided, Referly falls back seamlessly
# to MongoDB Memory Server for instant local development and zero-config evaluation.
MONGODB_URI=mongodb://localhost:27017/referly

# Security & Authentication (JWT Secrets)
# Generate secure, high-entropy secrets in production (e.g. `openssl rand -base64 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Optional Cloudinary (Resume & Profile Image Cloud Storage)
# If omitted, local in-memory/file storage fallbacks are utilized
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional SMTP Email Service (Notifications, referral alerts & invites)
# Use Mailtrap, SendGrid, or AWS SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=notifications@referly.careers
